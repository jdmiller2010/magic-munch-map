rules_version = '2';

// Magic Munch Map. Paste this into Firestore -> Rules in the Firebase console.
//
// Anything not matched below is denied by default, so the whole security
// model is this one allowlist. Add each Google account that should be able
// to read and edit the shared list.

service cloud.firestore {
  match /databases/{database}/documents {

    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'jdmiller2010@gmail.com'
             // , 'partner@example.com'
           ];
    }

    match /places/{placeId} {
      allow read, write: if allowed();
    }
  }
}
